datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  createdAt DateTime @default(now())   // Automatically set at creation
  updatedAt DateTime @updatedAt        // Automatically updated on modification
  id      Int    @id @default(autoincrement())
  name    String
  email   String
  subject String
  phone   String
  message String
  topic   String?

}
