datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  phone     String?
  message   String
  topic     String?
  createdAt DateTime @default(now())
}

